<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:local="using:OpenRamble.App.Linux"
        x:Class="OpenRamble.App.Linux.OverlayWindow"
        Title="OpenRamble dictation"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        automation:AutomationProperties.Name="OpenRamble dictation panel">
  <!--
    One piece of glass that grows to fit: a take is one line (244), a notice or an outcome a
    sentence (320), waiting words the words themselves (384). The margin is transparent room for
    the shadow; Place() lends it back to the edge so the glass sits where it always did.
  -->
  <Border x:Name="Panel"
          Classes="glass"
          Margin="20,12,20,28"
          Width="244"
          MinHeight="44">
    <Panel>
      <!-- A take: glyph, meter, clock. No words - after a lingering half second, a quiet title. -->
      <DockPanel x:Name="TakeLine" Height="44" Margin="18,0">
        <local:StateGlyph x:Name="TakeGlyph" DockPanel.Dock="Left" GlyphSize="12"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Classes="clock"
                   VerticalAlignment="Center" Margin="10,0,0,0" />
        <Panel VerticalAlignment="Center">
          <!-- The waveform is the only proof the microphone is receiving anything. -->
          <local:LevelWaveform x:Name="Waveform" Height="18" />
          <TextBlock x:Name="LingerText" FontSize="14" Foreground="{DynamicResource Label2}"
                     TextTrimming="CharacterEllipsis" IsVisible="False" />
        </Panel>
      </DockPanel>

      <!-- A notice, or how waiting words ended: one glyph and about eight words. -->
      <DockPanel x:Name="SentenceLine" Margin="18,13" MinHeight="18" IsVisible="False">
        <local:StateGlyph x:Name="SentenceGlyph" DockPanel.Dock="Left" GlyphSize="12"
                          VerticalAlignment="Top" Margin="0,4,10,0" />
        <TextBlock x:Name="SentenceText" FontSize="14" FontWeight="Medium" LineHeight="20"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>

      <!-- Words that could not land: the words first, in full, then why, then the one thing to do.
           The words are what the person is afraid of losing, so they are set as written text. -->
      <StackPanel x:Name="WaitingPanel" Spacing="12" Margin="22,20,14,14" IsVisible="False">
        <ScrollViewer x:Name="WordsScroll"
                      MaxHeight="168"
                      Margin="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="WordsText"
                     Classes="words19"
                     automation:AutomationProperties.Name="Your words" />
        </ScrollViewer>
        <TextBlock x:Name="NoteText" Classes="detail" Margin="0,0,8,0" IsVisible="False" />
        <DockPanel x:Name="ReasonRow" LastChildFill="True">
          <Button x:Name="CopiedLaterButton"
                  DockPanel.Dock="Right"
                  Classes="quiet"
                  Focusable="False"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Content="Later"
                  IsVisible="False"
                  automation:AutomationProperties.HelpText="Keeps the words in History" />
          <local:StateGlyph x:Name="ReasonGlyph" DockPanel.Dock="Left" GlyphSize="12"
                            VerticalAlignment="Top" Margin="0,3,8,0" />
          <TextBlock x:Name="ReasonText" FontSize="13" Foreground="{DynamicResource Label2}"
                     TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
        </DockPanel>
        <DockPanel x:Name="ActionRow" LastChildFill="False" Margin="0,2,0,0">
          <!-- Not focusable: a click is the action, and focus has nowhere useful to go. -->
          <Button x:Name="ActionButton" DockPanel.Dock="Left" Classes="ink" Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:KeyCap x:Name="ActionKeyCap" CapSize="Inline" OnInk="True" VerticalAlignment="Center" />
              <TextBlock x:Name="ActionVerbText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="LaterButton"
                  DockPanel.Dock="Right"
                  Classes="quiet"
                  Focusable="False"
                  Content="Later"
                  automation:AutomationProperties.HelpText="Keeps the words in History" />
        </DockPanel>
      </StackPanel>
    </Panel>
  </Border>
</Window>
