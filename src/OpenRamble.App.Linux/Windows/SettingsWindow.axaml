<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:DictationCore;assembly=DictationCore"
        xmlns:local="clr-namespace:OpenRamble.App.Linux"
        xmlns:c="clr-namespace:OpenRamble.App.Linux.Controls"
        x:Class="OpenRamble.App.Linux.SettingsWindow"
        Title="OpenRamble Settings"
        Width="720"
        Height="640"
        MinWidth="640"
        MinHeight="540"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">

  <!--
    Four pages behind a segmented switcher at the top, as upstream's window (0.37+): General,
    Setup, Dictionary, About. Each page is one centred column; a group is a BlockSection, a
    setting a BlockRow with its control on the right edge.
  -->
  <Window.Styles>
    <!--
      The small arrow that puts one setting back the way it came. Kept in the layout rather
      than removed when inactive, so no row jumps as settings change - it is faded out instead.
      See RevertToDefault.swift for why it is per setting and never "reset everything".
    -->
    <Style Selector="Button.revert">
      <Setter Property="Content" Value="↺" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.Tip" Value="Reset to default" />
      <Setter Property="automation:AutomationProperties.Name" Value="Reset to default" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="StackPanel.control">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="SelectableTextBlock.code">
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="segmentTrack" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="GeneralTab" Classes="segment" GroupName="SettingsPage"
                     automation:AutomationProperties.Name="General">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:LucideIcon Data="{StaticResource IconSettings}" Width="14" Height="14" />
            <TextBlock Text="General" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SetupTab" Classes="segment" GroupName="SettingsPage"
                     automation:AutomationProperties.Name="Setup">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:LucideIcon Data="{StaticResource IconListChecks}" Width="14" Height="14" />
            <TextBlock Text="Setup" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="DictionaryTab" Classes="segment" GroupName="SettingsPage"
                     automation:AutomationProperties.Name="Dictionary">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:LucideIcon Data="{StaticResource IconBookA}" Width="14" Height="14" />
            <TextBlock Text="Dictionary" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="AboutTab" Classes="segment" GroupName="SettingsPage"
                     automation:AutomationProperties.Name="About">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:LucideIcon Data="{StaticResource IconInfo}" Width="14" Height="14" />
            <TextBlock Text="About" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <Panel>

      <!-- General -->
      <ScrollViewer x:Name="GeneralPage">
        <Border Classes="page">
          <StackPanel Spacing="40">

            <!-- The two things a person actually chooses here, each as a block. -->
            <Grid ColumnDefinitions="*,16,*">
              <Border Classes="content" Padding="20">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="sectionHeader" Text="Dictation key" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="quiet revert" x:Name="RevertHotkey" Click="OnRevertHotkey" />
                  </Grid>
                  <!-- The cap goes down while the real key is held: hold it here and the setting
                       answers the hand. Clicking it opens the list of keys. -->
                  <local:KeyCap x:Name="HotkeyCap" CapSize="Large" HorizontalAlignment="Center"
                                Cursor="Hand" Margin="0,6,0,0"
                                ToolTip.Tip="Choose the dictation key" />
                  <ComboBox x:Name="HotkeyPicker" HorizontalAlignment="Center" MinWidth="160"
                            automation:AutomationProperties.Name="Dictation key"
                            automation:AutomationProperties.HelpText="The key you hold down while dictating" />
                  <TextBlock x:Name="HotkeyWarning" Classes="problem" Margin="0" IsVisible="False" />
                  <TextBlock x:Name="HotkeyHint" Classes="detail"
                             Text="Hold to talk, or double-press for hands-free dictation. Press once more to finish." />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="content" Padding="20">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="sectionHeader" Text="Microphone" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="quiet revert" x:Name="RevertDevice" Click="OnRevertDevice" />
                  </Grid>
                  <ComboBox x:Name="DevicePicker" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                            automation:AutomationProperties.Name="Microphone"
                            automation:AutomationProperties.HelpText="Which input to record through. The system default follows whatever your desktop is using." />
                  <!-- Said out loud rather than swapped silently: someone who chose a headset and
                       quietly got the laptop lid would only find out from the transcript. -->
                  <TextBlock x:Name="DeviceNotice" Classes="problem" Margin="0" IsVisible="False" />
                  <TextBlock Classes="detail"
                             Text="The system default follows whatever your desktop is using." />
                </StackPanel>
              </Border>
            </Grid>

            <local:BlockSection Header="Shortcuts"
                                Footer="These work from any app. The paste shortcut puts your newest dictation into the app in front; clear it to give the keys back to another app.">
              <local:BlockRow Title="Paste last take">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertLastTakeShortcut" Click="OnRevertLastTakeShortcut" />
                  <local:ShortcutRecorderButton x:Name="LastTakeShortcutRecorder"
                                                automation:AutomationProperties.HelpText="Press this shortcut to paste your newest dictation into the app in front" />
                </StackPanel>
              </local:BlockRow>
              <TextBlock x:Name="LastTakeShortcutProblem" Classes="problem" HorizontalAlignment="Right"
                         IsVisible="False" />
              <Border Classes="hairline" />
              <local:BlockRow Title="Start or stop recording">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertRecordingShortcut" Click="OnRevertRecordingShortcut" />
                  <local:ShortcutRecorderButton x:Name="RecordingShortcutRecorder"
                                                automation:AutomationProperties.HelpText="Press this shortcut in any app to start a recording, and again to stop it" />
                </StackPanel>
              </local:BlockRow>
              <TextBlock x:Name="RecordingShortcutProblem" Classes="problem" HorizontalAlignment="Right"
                         IsVisible="False" />
            </local:BlockSection>

            <local:BlockSection Header="Dictation">
              <local:BlockRow Title="Add a space after each dictation"
                              Detail="For dictating in runs, so the next phrase does not arrive welded to the last word.">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertTrailingSpace" Click="OnRevertTrailingSpace" />
                  <ToggleSwitch x:Name="TrailingSpaceToggle"
                                automation:AutomationProperties.Name="Add a space after each dictation"
                                automation:AutomationProperties.HelpText="For dictating in runs, so the next phrase does not arrive welded to the last word." />
                </StackPanel>
              </local:BlockRow>
              <Border Classes="hairline" />
              <local:BlockRow Title="Finish hands-free dictation on silence"
                              Detail="Only in hands-free mode. While you hold the key, a pause is never treated as the end.">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertSilence" Click="OnRevertSilence" />
                  <ToggleSwitch x:Name="SilenceToggle"
                                automation:AutomationProperties.Name="Finish hands-free dictation on silence"
                                automation:AutomationProperties.HelpText="Only in hands-free mode. While you hold the key, a pause is never treated as the end." />
                </StackPanel>
              </local:BlockRow>
              <Border Classes="hairline" />
              <local:BlockRow Title="Play a sound when something needs you"
                              Detail="A quiet tone when the text didn't reach the field or nothing was recognized. A dictation that works stays silent.">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertSounds" Click="OnRevertSounds" />
                  <ToggleSwitch x:Name="SoundsToggle"
                                automation:AutomationProperties.Name="Play a sound when something needs you"
                                automation:AutomationProperties.HelpText="A quiet tone when the text didn't reach the field or nothing was recognized. A dictation that works stays silent." />
                </StackPanel>
              </local:BlockRow>
              <Border Classes="hairline" />
              <local:BlockRow Title="Dictation panel">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertPlacement" Click="OnRevertPlacement" />
                  <ComboBox x:Name="PlacementPicker" MinWidth="160"
                            automation:AutomationProperties.Name="Dictation panel"
                            automation:AutomationProperties.HelpText="Places dictation feedback at the top or bottom of the active screen" />
                </StackPanel>
              </local:BlockRow>
            </local:BlockSection>

            <!-- The dictations themselves are listed in the Library (upstream 0.37); the limit stays here. -->
            <local:BlockSection Header="History"
                                Footer="Your dictations live in the Library, next to your recordings, with the audio that produced them. A starred one stays: it does not count against the limit and is not deleted when newer dictations push past it. Nothing here ever leaves this PC.">
              <local:BlockRow Title="History keeps">
                <ComboBox x:Name="HistoryLimitPicker" MinWidth="120"
                          automation:AutomationProperties.Name="History keeps"
                          automation:AutomationProperties.HelpText="How many dictations to keep, with their audio" />
              </local:BlockRow>
              <Border Classes="hairline" />
              <local:BlockRow Title="Dictations and their audio">
                <StackPanel Classes="control" Spacing="8">
                  <Button x:Name="ShowHistoryButton" Classes="plain" Content="Show in folder"
                          Click="OnRevealHistory"
                          automation:AutomationProperties.HelpText="Opens the folder holding the audio kept with these dictations" />
                  <Button x:Name="ClearHistoryButton" Classes="plain" Content="Delete All"
                          Click="OnClearHistory" />
                </StackPanel>
              </local:BlockRow>
            </local:BlockSection>

            <local:BlockSection Header="Appearance">
              <local:BlockRow Title="Theme">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertTheme" Click="OnRevertTheme" />
                  <ComboBox x:Name="ThemePicker" MinWidth="160"
                            automation:AutomationProperties.Name="Theme"
                            automation:AutomationProperties.HelpText="Follow the desktop, or keep this app light or dark on its own" />
                </StackPanel>
              </local:BlockRow>
            </local:BlockSection>

            <local:BlockSection Header="OpenRamble">
              <local:BlockRow Title="Launch at login"
                              Detail="Starts OpenRamble automatically when you sign in.">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertLaunch" Click="OnRevertLaunch" />
                  <ToggleSwitch x:Name="LaunchToggle"
                                automation:AutomationProperties.Name="Launch at login"
                                automation:AutomationProperties.HelpText="Starts OpenRamble automatically when you sign in" />
                </StackPanel>
              </local:BlockRow>
            </local:BlockSection>

            <local:BlockSection Header="Command line"
                                Footer="Transcribe audio files using the installed model, even while the app is closed. Creates a link in ~/.local/bin; does not change your shell settings.">
              <local:BlockRow Title="Command-line tool">
                <StackPanel Classes="control" Spacing="8">
                  <Button x:Name="CliUninstallButton" Classes="quiet" Content="Remove"
                          Click="OnUninstallCommandLineTool" />
                  <Button x:Name="CliInstallButton" Classes="plain" Click="OnInstallCommandLineTool" />
                </StackPanel>
              </local:BlockRow>
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock x:Name="CliStatus" Classes="detail" />
                <SelectableTextBlock x:Name="CliUsage" Classes="code" Text="Run: openramble audio.m4a" />
                <StackPanel x:Name="CliPathHint" IsVisible="False" Spacing="4" Margin="0,4,0,0">
                  <TextBlock Classes="detail"
                             Text="~/.local/bin is not on this session's PATH. If your terminal says 'command not found', add this line to your shell startup file, such as ~/.bashrc, then open a new terminal:" />
                  <SelectableTextBlock Classes="code" Text="export PATH=&quot;$HOME/.local/bin:$PATH&quot;" />
                </StackPanel>
              </StackPanel>
            </local:BlockSection>

            <local:BlockSection Header="Privacy"
                                Footer="Speech is recognized by a model that lives on this machine. No audio and no text is ever sent anywhere. There is no account and no analytics. Reports contain technical events and available crash details, never your speech, and nothing is sent automatically. The one network request in the app's life is downloading the recognition model, when you ask it to.">
              <local:BlockRow Title="Keep local diagnostics"
                              Detail="Keeps technical events for up to 7 days, limited to 5 MB. No speech or personal content. Turning this off clears the journal.">
                <StackPanel Classes="control">
                  <Button Classes="quiet revert" x:Name="RevertLogging" Click="OnRevertLogging" />
                  <ToggleSwitch x:Name="LoggingToggle"
                                automation:AutomationProperties.Name="Keep local diagnostics"
                                automation:AutomationProperties.HelpText="Keeps technical events for up to 7 days, limited to 5 MB. No speech or personal content. Turning this off clears the journal." />
                </StackPanel>
              </local:BlockRow>
            </local:BlockSection>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Setup: one row per thing dictation needs, each with its one action. -->
      <ScrollViewer x:Name="SetupPage" IsVisible="False">
        <Border Classes="page">
          <StackPanel Spacing="40">
            <local:BlockSection Header="Speech model"
                                Footer="Parakeet Ultra runs entirely on this PC, through transcribe.cpp on the processor. A PC that already holds the earlier model, Parakeet TDT 0.6B v3, keeps dictating with it until Ultra is downloaded and ready. Once downloaded and verified, recognition works offline — audio is never uploaded. The model picks the language from the sound itself, including mid-sentence switches, so there is nothing to choose here. Audio is retained only after a disclosed technical failure or interrupted process, then pruned within seven days; those takes are listed in the Library.">
              <local:SetupRow x:Name="ModelRow" />
              <!-- The newer model, offered while the one already installed keeps dictating. -->
              <Border x:Name="UpgradeDivider" Classes="hairline" IsVisible="False" />
              <local:SetupRow x:Name="UpgradeRow" IsVisible="False" />
            </local:BlockSection>

            <local:BlockSection Header="Permissions"
                                Footer="Finished text is pasted through the clipboard; its previous contents are restored shortly afterward.">
              <local:SetupRow x:Name="MicrophoneRow" />
              <Border Classes="hairline" />
              <local:SetupRow x:Name="KeyTrackingRow" Title="Dictation key" />
            </local:BlockSection>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Dictionary: the list fills the page, so it is not inside a scroll viewer of its own. -->
      <Border x:Name="DictionaryPage" Classes="page" IsVisible="False">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="body" TextWrapping="Wrap"
                     Text="Common technical terms are handled automatically. Add personal names or phrases the model hears differently: what the model hears on the left, what should be written on the right." />
          <TextBlock x:Name="DictionaryProblem" DockPanel.Dock="Top" Classes="problem"
                     Margin="0,8,0,0" IsVisible="False" />

          <!-- The only place where the application reads the content of someone else's window.
               Off by default, and the caption says exactly what is read - otherwise the choice is
               not conscious. It lives here because what it produces is dictionary entries. -->
          <local:BlockSection DockPanel.Dock="Bottom" Margin="0,24,0,0"
                              Footer="Off by default. After a paste, OpenRamble can re-read only that field at 8 and 25 seconds to learn a correction. The content stays on this PC. On this desktop nothing can read another window's text yet, so the switch changes nothing until it can.">
            <local:BlockRow Title="Learn from your edits">
              <ToggleSwitch x:Name="LearnToggle"
                            automation:AutomationProperties.Name="Learn from your edits"
                            automation:AutomationProperties.HelpText="Reads back the field it pasted into, to learn words you fix by hand" />
            </local:BlockRow>
          </local:BlockSection>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <TextBox x:Name="SpokenBox" Watermark="Spoken phrase"
                     automation:AutomationProperties.Name="Heard as" />
            <TextBlock Grid.Column="1" Classes="body" Text="→" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" x:Name="WrittenBox" Watermark="Final spelling"
                     automation:AutomationProperties.Name="Write as" />
            <Button Grid.Column="3" Classes="ink" Content="Add" Click="OnAddReplacement"
                    automation:AutomationProperties.Name="Add replacement" />
          </Grid>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,24,0,0">
            <TextBlock Classes="sectionHeader" Text="Replacements" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Classes="control" Spacing="4">
              <Button Classes="quiet" Content="Import…" Click="OnImportDictionary"
                      automation:AutomationProperties.HelpText="Adds phrases from an OpenRamble dictionary file" />
              <Button x:Name="ExportButton" Classes="quiet" Content="Export…" Click="OnExportDictionary"
                      automation:AutomationProperties.HelpText="Saves all phrases to a file" />
              <Button Classes="quiet" Content="Remove selected" Click="OnRemoveReplacement" />
            </StackPanel>
          </Grid>
          <Border DockPanel.Dock="Top" Classes="hairline" Margin="0,6,0,0" />

          <Grid DockPanel.Dock="Top" ColumnDefinitions="240,*" Margin="12,10,0,4">
            <TextBlock Grid.Column="0" Classes="small" Text="Heard" FontWeight="Medium" />
            <TextBlock Grid.Column="1" Classes="small" Text="Written" FontWeight="Medium" />
          </Grid>

          <!-- An empty dictionary is common for a new person, and it used to be just a
               half-window gap without a single word. -->
          <TextBlock x:Name="DictionaryEmpty" DockPanel.Dock="Top" Classes="detail" Margin="12,8"
                     Text="No personal replacements yet. Add a pair below: what the model hears on the left, what should be written on the right."
                     IsVisible="False" />

          <ListBox x:Name="ReplacementList" Background="Transparent"
                   automation:AutomationProperties.Name="Replacement dictionary">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:DictionaryReplacement">
                <Grid ColumnDefinitions="240,*">
                  <TextBlock Grid.Column="0" Text="{Binding Spoken}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Written}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- About -->
      <ScrollViewer x:Name="AboutPage" IsVisible="False">
        <Border Classes="page">
          <StackPanel Spacing="40">
            <Border Classes="content">
              <StackPanel Spacing="3">
                <TextBlock Classes="display26" Text="OpenRamble" />
                <TextBlock Classes="body" Text="Private dictation for your PC" />
                <SelectableTextBlock x:Name="VersionText" Classes="tnum" FontSize="11"
                                     Foreground="{DynamicResource Label2}" />
              </StackPanel>
            </Border>

            <local:BlockSection Header="Support"
                                Footer="Reports contain technical events and available crash details, never your speech. Nothing is sent automatically.">
              <local:BlockRow Title="Error report"
                              Detail="A ZIP of local technical events and available crash reports, to attach to a bug report yourself.">
                <Button x:Name="SaveReportButton" Classes="plain" Content="Save Error Report…" Click="OnSaveErrorReport"
                        automation:AutomationProperties.HelpText="Saves a ZIP with local technical events and available crash reports. Nothing is sent automatically." />
              </local:BlockRow>
              <Border Classes="hairline" />
              <local:BlockRow Title="Recordings kept after a failure"
                              Detail="Dictations that didn't finish keep their audio so nothing is lost. It is deleted within seven days.">
                <Button Classes="plain" Content="Open recordings folder" Click="OnOpenRecordings"
                        automation:AutomationProperties.HelpText="Opens the folder with any recordings kept after a failure" />
              </local:BlockRow>
            </local:BlockSection>

            <local:BlockSection Header="Credits">
              <StackPanel Spacing="6" Margin="0,10,0,0">
                <TextBlock Classes="detail"
                           Text="Parakeet Ultra © Moondream and Parakeet TDT 0.6B v3 © NVIDIA, licensed under CC BY 4.0. GGUF conversion by handy-computer." />
                <TextBlock Classes="detail"
                           Text="Recognition runs through transcribe.cpp (MIT, with ggml, miniz and Silero VAD, MIT); the earlier model runs through sherpa-onnx (Apache 2.0)." />
                <TextBlock Classes="detail"
                           Text="The interface is built with Avalonia (MIT), set in Source Serif 4 (SIL Open Font License 1.1) with Lucide icons (ISC)." />
                <TextBlock Classes="detail"
                           Text="This is an unofficial port of OpenRamble by Mik Wiseman (MIT)." />
                <Button Classes="quiet" Content="View source on GitHub" Click="OnOpenSource"
                        HorizontalAlignment="Left" Margin="-14,6,0,0" />
              </StackPanel>
            </local:BlockSection>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</Window>
