<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="OpenRamble.App.Linux.LibraryWindow"
        Title="Library"
        Width="1000"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <!--
    Upstream RecordingsWindow.swift: a list of everything said on the left, the selected thing on
    the right. The whole window takes a dropped file - nobody aims a drag at a button.
  -->
  <Window.Styles>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="Gray" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBoxItem.day">
      <Setter Property="Padding" Value="10,12,10,2" />
    </Style>
  </Window.Styles>

  <Panel>
    <DockPanel>
      <!-- The toolbar: Import, Open folder, Copy, Trash. -->
      <Border DockPanel.Dock="Top" BorderBrush="#33808080" BorderThickness="0,0,0,1" Padding="10,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Classes="tool" x:Name="ImportButton" Click="OnImport"
                  ToolTip.Tip="Import audio or video to transcribe"
                  automation:AutomationProperties.Name="Import Audio or Video…">
            <Panel>
              <TextBlock x:Name="ImportLabel" Text="Import…" VerticalAlignment="Center" />
              <ProgressBar x:Name="ImportSpinner" IsIndeterminate="True" IsVisible="False"
                           MinWidth="48" Width="48" VerticalAlignment="Center" />
            </Panel>
          </Button>
          <Button Classes="tool" x:Name="RevealButton" Content="Open folder" Click="OnReveal"
                  automation:AutomationProperties.Name="Open folder" />
          <Button Classes="tool" x:Name="CopyButton" Content="Copy" Click="OnCopy" />
          <Button Classes="tool" x:Name="TrashButton" Content="Trash" Click="OnTrash" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="300,Auto,*">
        <DockPanel Grid.Column="0" MinWidth="240">
          <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6" Spacing="8">
            <ComboBox x:Name="ScopePicker" HorizontalAlignment="Stretch"
                      automation:AutomationProperties.Name="Show" />
            <TextBox x:Name="SearchBox" Watermark="Search what you said"
                     automation:AutomationProperties.Name="Search what you said" />
          </StackPanel>
          <ListBox x:Name="ItemList" SelectionMode="Multiple" Background="Transparent"
                   automation:AutomationProperties.Name="Library" />
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="1" Background="#33808080" ResizeDirection="Columns" />

        <!-- The seam for the detail panes: the code sets Detail.Content from the selection. -->
        <ContentControl Grid.Column="2" x:Name="Detail" MinWidth="440"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
    </DockPanel>

    <!-- Shown while a file is dragged over the window (upstream ImportDropOverlay). -->
    <Border x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
            Background="#CC202020" Margin="8" CornerRadius="10"
            BorderBrush="#AAFFFFFF" BorderThickness="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="Drop to transcribe" FontSize="20" FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Audio or video files are added to the Library." Foreground="#DDFFFFFF"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
