<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpenRamble.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- Allows the WPF app to be built (not run) on a non-Windows host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The Win32 adapters marshal by hand; every P/Invoke here is source-generated. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/OpenRamble.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The same file again as a WPF resource, not only as the executable's icon: the windows name
      it by pack URI, and TrayIconArt reads its 32-pixel plane to draw the tray picture on.
    -->
    <Resource Include="Assets/OpenRamble.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LocalASR/LocalASR.csproj" />
    <ProjectReference Include="../OpenRamble.AppCore/OpenRamble.AppCore.csproj" />
    <ProjectReference Include="../OpenRamble.WindowsAudio/OpenRamble.WindowsAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pinned exactly: the audio path is the one place a silent behaviour change costs words.
      Still named here even though OpenRamble.WindowsAudio brings it in: MicrophoneConsent opens
      the endpoint itself to find out whether the microphone is granted.
    -->
    <PackageReference Include="NAudio" Version="[2.2.1]" />
  </ItemGroup>

</Project>
