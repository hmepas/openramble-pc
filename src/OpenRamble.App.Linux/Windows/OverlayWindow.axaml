<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="OpenRamble.App.Linux.OverlayWindow"
        Title="OpenRamble dictation"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        automation:AutomationProperties.Name="OpenRamble dictation panel">
  <Border x:Name="Panel"
          CornerRadius="12"
          Padding="16,12"
          MinWidth="260"
          Background="#F21C1C1E"
          BorderBrush="#33FFFFFF"
          BorderThickness="1">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse x:Name="ToneDot" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TitleText"
                   FontSize="14"
                   Foreground="#FFF5F5F7"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
        <TextBlock x:Name="SubtitleText"
                   FontSize="12"
                   Foreground="#B3F5F5F7"
                   Margin="0,2,0,0"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   IsVisible="False" />
      </StackPanel>
      <!-- The waveform is the only proof the microphone is receiving anything. -->
      <Canvas x:Name="Waveform"
              Width="96"
              Height="24"
              Margin="16,0,0,0"
              VerticalAlignment="Center"
              IsVisible="False" />
    </StackPanel>
  </Border>
</Window>
