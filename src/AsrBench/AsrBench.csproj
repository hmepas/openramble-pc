<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Two targets, one command that differs. `mic` records through the shipping capture, and which
      capture that is depends on the platform: WASAPI on Windows, `pw-record` everywhere else.
      Multi-targeting keeps both honest - each build references exactly the capture it can run,
      and neither has to pretend the other's audio stack exists.
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <!-- Allows the Windows target to be built (not run) on a non-Windows host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AsrBench</RootNamespace>
    <AssemblyName>asr-bench</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LocalASR/LocalASR.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="../OpenRamble.WindowsAudio/OpenRamble.WindowsAudio.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!--
      Unconditionally in the portable target rather than behind an OS check: the library is
      ordinary managed code that builds anywhere, and the command it serves refuses at run time on
      a host with no PipeWire. A reference that came and went with the build machine would make
      this project build differently on two machines, which is worse than one unused assembly.
    -->
    <ProjectReference Include="../OpenRamble.LinuxAudio/OpenRamble.LinuxAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Swift package scores its own quality numbers from a separate test target
      (`ASRBenchTests`) that reaches into the tool with `@testable import asr_bench`.
      The scorer types stay internal here for the same reason they are internal there:
      they are the tool's own vocabulary, not a library contract.
    -->
    <InternalsVisibleTo Include="LocalASR.Tests" />
  </ItemGroup>

  <!-- The transcribe.cpp runtime next to the portable build; see the file. -->
  <Import Project="../LocalASR/TranscribeCppNative.props" Condition="'$(TargetFramework)' == 'net10.0'" />

</Project>
