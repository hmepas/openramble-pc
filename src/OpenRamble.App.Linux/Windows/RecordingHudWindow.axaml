<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:local="using:OpenRamble.App.Linux"
        x:Class="OpenRamble.App.Linux.RecordingHudWindow"
        Title="OpenRamble recording"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        Cursor="Hand"
        automation:AutomationProperties.Name="OpenRamble recording indicator">
  <!-- One glass capsule, a block unit tall. The margin is transparent room for its shadow. -->
  <Border x:Name="Pill"
          Classes="glassCapsule"
          Margin="20,12,20,28"
          Height="44"
          Padding="18,0"
          ToolTip.Tip="Open the Library">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <!-- Red is the microphone capturing. Paused or saving, it is not. -->
      <local:StateGlyph x:Name="Glyph" GlyphSize="12" VerticalAlignment="Center" />
      <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
      <TextBlock x:Name="TimeText" Classes="clock" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
