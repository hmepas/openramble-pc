<Window x:Class="OpenRamble.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenRamble Settings"
        Icon="/Assets/OpenRamble.ico"
        Width="720"
        Height="600"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <!--
        Five panes, the same five as the original: General, Recognition, Dictation History,
        Dictionary, About. A tab strip rather than a sidebar - the sidebar exists on the Mac for
        the sake of a window material this port does not have.
    -->
    <TabControl Margin="12" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}">

        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,8,16,16">
                    <TextBlock Text="Shortcut" Style="{StaticResource SectionHeader}" Margin="0,4,0,4" />
                    <!-- Dictation key, Copy last dictation: built in code, see ShortcutRows. -->
                    <StackPanel x:Name="ShortcutRows" />
                    <TextBlock x:Name="HotkeyWarning" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="CopyShortcutProblem" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Footer}"
                               Text="Hold to talk, or double-press for hands-free dictation. Press once more to finish. The copy shortcut is off until you choose one - a shortcut nobody asked for collides with something you already use." />

                    <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" />
                    <StackPanel x:Name="BehaviorRows" />
                    <TextBlock x:Name="InputDeviceNotice" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="Collapsed" />

                    <TextBlock Text="Permissions" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="PermissionTitle" Margin="0,2,0,0" />
                    <TextBlock x:Name="PermissionDetail" Style="{StaticResource Secondary}" Margin="0,2,0,6" />
                    <Button x:Name="PermissionButton" HorizontalAlignment="Left" Padding="12,4"
                            Click="OnPermissionAction" />
                    <TextBlock Style="{StaticResource Footer}"
                               Text="Finished text is pasted through the clipboard; its previous contents are restored shortly afterward." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Recognition">
            <StackPanel Margin="16">
                <TextBlock Text="Speech model" Style="{StaticResource SectionHeader}" Margin="0,4,0,4" />
                <TextBlock x:Name="ModelTitle" FontWeight="SemiBold" />
                <TextBlock x:Name="ModelDetail" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed"
                             Minimum="0" Maximum="1" />
                <TextBlock x:Name="ModelProgressLabel" Style="{StaticResource Secondary}" Margin="0,4,0,0"
                           Visibility="Collapsed" />
                <StackPanel x:Name="ModelActions" Orientation="Horizontal" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Footer}"
                           Text="Parakeet TDT 0.6B v3 runs entirely on this PC. Once downloaded and verified, recognition works offline - audio is never uploaded. Audio is retained only after a disclosed technical failure or interrupted process, then pruned within seven days. Interrupted dictations are kept beside your dictation history; see the History tab." />
            </StackPanel>
        </TabItem>

        <TabItem Header="Dictation History">
            <DockPanel Margin="16,8,16,16">
                <!-- Dictations that never became text, kept as audio so nothing was lost. -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="0,4,0,10" Margin="0,0,0,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Show in folder" Padding="12,4"
                                VerticalAlignment="Center" Click="OnOpenRecordings"
                                AutomationProperties.HelpText="Opens the folder holding the kept audio" />
                        <StackPanel>
                            <TextBlock Text="Dictations that didn't finish" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Text="Their audio was kept so nothing was lost. It is deleted within seven days." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Footer: how many to keep, and the two buttons that act on the whole list. -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="HistoryLimitPicker" Width="110"
                                          AutomationProperties.Name="Keep"
                                          AutomationProperties.HelpText="How many dictations to keep, with their audio" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ShowRecordingsButton" Content="Show Recordings" Padding="12,4"
                                        Click="OnRevealHistoryAudio"
                                        AutomationProperties.HelpText="Opens the folder holding the audio kept with these dictations" />
                                <Button x:Name="DeleteAllButton" Content="Delete All" Padding="12,4"
                                        Margin="8,0,0,0" Click="OnClearHistory" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Footer}"
                                   Text="The last few dictations stay on this PC with their audio until they age out of the list or you delete them. A starred dictation stays: it does not count against the limit and is not deleted when newer ones push past it. Recognize again re-runs the model over the kept audio - after you have taught the dictionary something, the words the model heard do not change, but what they turn into does." />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="HistoryEmpty" Margin="0,40,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="No dictations yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                                       Text="Finished dictations appear here with their audio." />
                        </StackPanel>
                        <StackPanel x:Name="HistoryList" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <TabItem Header="Dictionary">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}"
                           Text="Common technical terms are handled automatically. Add personal names or phrases the model hears differently: what the model hears on the left, what should be written on the right." />
                <TextBlock x:Name="DictionaryProblem" DockPanel.Dock="Top" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed" />

                <!-- The only place the application reads the content of someone else's window. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Personalization" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <CheckBox x:Name="LearnToggle" Content="Learn from your edits"
                              AutomationProperties.HelpText="Reads back the field it pasted into, to learn words you fix by hand" />
                    <TextBlock Style="{StaticResource Footer}"
                               Text="Off by default. After a paste, OpenRamble can re-read only that field at 8 and 25 seconds to learn a correction. The content stays on this PC." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox x:Name="SpokenBox" Width="180" AutomationProperties.Name="Heard as" />
                    <TextBlock Text="→" Margin="8,4" />
                    <TextBox x:Name="WrittenBox" Width="180" AutomationProperties.Name="Write as" />
                    <Button Content="Add" Margin="8,0,0,0" Padding="12,2" Click="OnAddReplacement" />
                    <Button Content="Remove selected" Margin="8,0,0,0" Padding="12,2" Click="OnRemoveReplacement" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Import…" Padding="12,2" Click="OnImportDictionary"
                            AutomationProperties.HelpText="Adds phrases from an OpenRamble dictionary file" />
                    <Button Content="Export…" Margin="8,0,0,0" Padding="12,2" Click="OnExportDictionary"
                            AutomationProperties.HelpText="Saves all phrases to a file" />
                </StackPanel>

                <ListView x:Name="ReplacementList" Margin="0,10,0,0"
                          AutomationProperties.Name="Replacement dictionary">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Heard" Width="240" DisplayMemberBinding="{Binding Spoken}" />
                            <GridViewColumn Header="Written" Width="240" DisplayMemberBinding="{Binding Written}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem Header="About">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Image Source="/Assets/OpenRamble.ico" Width="56" Height="56" Margin="0,0,14,0"
                               VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OpenRamble" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Private dictation for your PC" Style="{StaticResource Secondary}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
                    <StackPanel x:Name="AppearanceRows" />

                    <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Speech stays on this PC" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8"
                               Text="Speech is recognized by a model that lives on this machine. No audio and no text is ever sent anywhere; the only network request the app makes is downloading the model, when you ask it to. There is no telemetry, no analytics and no crash reporting. Dictated words are never written to a log." />
                    <StackPanel x:Name="PrivacyRows" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open Logs" Padding="12,4" Click="OnOpenLogs"
                                AutomationProperties.Name="Open log folder" />
                        <Button Content="Open Recovered Recordings" Padding="12,4" Margin="8,0,0,0"
                                Click="OnOpenRecordings"
                                AutomationProperties.HelpText="Opens the folder with any recordings kept after a failure" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Footer}"
                               Text="No account, analytics, or cloud transcription. Network access is limited to the model download. Recordings kept after a failure live in the recovered-recordings folder for a few days; the dictation history and its audio live beside the settings." />

                    <TextBlock Text="Credits" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource Secondary}"
                               Text="Parakeet TDT 0.6B v3 © NVIDIA, licensed under CC BY 4.0, run through sherpa-onnx (Apache 2.0) as a weight-only int4 build. WASAPI capture via NAudio (MIT). An unofficial port of OpenRamble for macOS by Mik Wiseman (MIT), which the icon and the product behavior follow." />
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink NavigateUri="https://github.com/mikwiseman/openramble" RequestNavigate="OnOpenLink">View source on GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
