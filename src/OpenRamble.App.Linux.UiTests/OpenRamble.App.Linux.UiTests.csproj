<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenRamble.App.Linux.UiTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      The windows themselves, laid out and driven without a display: the same toolkit version the
      app pins, with Skia so text is measured the way the desktop measures it.
    -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="[11.3.20]" />
    <PackageReference Include="Avalonia.Skia" Version="[11.3.20]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenRamble.App.Linux/OpenRamble.App.Linux.csproj" />
    <!-- AppHarness and its fakes: the windows are built over the same test AppState the core tests use. -->
    <ProjectReference Include="../OpenRamble.AppCore.Tests/OpenRamble.AppCore.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
