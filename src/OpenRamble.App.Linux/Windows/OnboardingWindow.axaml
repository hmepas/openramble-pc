<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="OpenRamble.App.Linux.OnboardingWindow"
        Title="Welcome to OpenRamble"
        Width="560"
        Height="640"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <DockPanel Margin="24">

    <TextBlock x:Name="ProgressText" DockPanel.Dock="Top" Foreground="Gray" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="SkipButton" Content="Skip the try-out" Padding="12,4" Margin="0,0,8,0"
              IsVisible="False" Click="OnSkip" />
      <Button x:Name="BackButton" Content="Back" Padding="12,4" Margin="0,0,8,0" Click="OnBack" />
      <Button x:Name="NextButton" Content="Continue" Padding="16,4" IsDefault="True" Click="OnNext" />
    </StackPanel>

    <TextBlock x:Name="BlockReason" DockPanel.Dock="Bottom" TextWrapping="Wrap"
               Margin="0,12,0,0" IsVisible="False" />

    <StackPanel x:Name="Body" Margin="0,16,0,0">

      <StackPanel x:Name="WelcomePage">
        <TextBlock Text="Hold a key. Speak. Let go." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="The text appears where your cursor already was — in any application, without switching windows." />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Recognition happens on this PC. Nothing you say is sent anywhere, and there is no account to create." />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="Two things are needed before the first dictation: the microphone, and a recognition model to download once." />
      </StackPanel>

      <StackPanel x:Name="SetupPage" IsVisible="False">
        <TextBlock Text="Microphone" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="PermissionDetail" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray" />
        <Button x:Name="PermissionButton" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0"
                Click="OnPermissionAction" />

        <Separator Margin="0,18" />

        <TextBlock x:Name="ModelTitle" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="ModelDetail" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray" />
        <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1"
                     IsVisible="False" />
        <TextBlock x:Name="ModelProgressLabel" Foreground="Gray" Margin="0,4,0,0" IsVisible="False" />
        <StackPanel x:Name="ModelActions" Orientation="Horizontal" Margin="0,12,0,0" />
      </StackPanel>

      <StackPanel x:Name="TryPage" IsVisible="False">
        <TextBlock Text="Try it once" FontSize="18" FontWeight="SemiBold" />

        <!--
            The key is chosen here and not only in Settings, because this is the page where a key
            that does not arrive is discovered - and sending somebody out of the first-launch flow
            to fix it is how a first launch ends. Same property, same file on disk, same live
            re-arming as the Settings picker: one source of truth.
        -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Dictation key" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox x:Name="TryHotkeyPicker" Width="180"
                    automation:AutomationProperties.Name="Dictation key"
                    automation:AutomationProperties.HelpText="The key you hold down while dictating" />
        </StackPanel>
        <TextBlock x:Name="TryHotkeyWarning" TextWrapping="Wrap" Margin="0,6,0,0"
                   IsVisible="False" />

        <TextBlock x:Name="TryInstruction" Margin="0,8,0,0" TextWrapping="Wrap" />

        <!--
            The badge and the line beside it are the step's whole purpose: they change the moment
            the key reaches OpenRamble, so a key that never arrives - swallowed by a virtual-machine
            client, or never tracked at all - looks different from a dictation that started and came
            back empty. Live-announced, because for a blind person a badge that lights up silently
            is the same as no badge.
        -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Border x:Name="TryKeyBadge" CornerRadius="6" Padding="10,4" BorderThickness="1"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="TryKeyDot" Width="8" Height="8" Margin="0,0,8,0"
                       VerticalAlignment="Center" />
              <TextBlock x:Name="TryKeyName" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="TryStatus" Margin="12,0,0,0" MaxWidth="360"
                     TextWrapping="Wrap" VerticalAlignment="Center"
                     automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Same scale as the panel's waveform, so silence still shows a line rather than an empty
             bar that reads as a dead microphone. -->
        <ProgressBar x:Name="TryLevel" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                     IsVisible="False"
                     automation:AutomationProperties.Name="Microphone level" />

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="Click into the box below first, so the words have somewhere to land." />

        <!--
            Hold with the mouse instead of the key. Not a shortcut around the try-out but a way
            through it: a key eaten by a virtual machine client or a remote desktop never reaches
            this process, and without this button the person cannot tell that from a product that
            does not work at all.

            Focusable="False" on purpose, and it is a real trade-off. The text is inserted into
            whatever has focus, so a button that took focus would paste the dictation into itself;
            the price is that the hold is mouse and touch only.
        -->
        <Button x:Name="TryHoldButton" Content="Hold to dictate"
                HorizontalAlignment="Left" Padding="16,6" Margin="0,10,0,0"
                Focusable="False"
                automation:AutomationProperties.Name="Hold to dictate"
                automation:AutomationProperties.HelpText="Press and hold with the mouse, speak, then let go. Does exactly what holding the dictation key does." />

        <TextBox x:Name="TryBox" Margin="0,10,0,0" Height="90" AcceptsReturn="True"
                 TextWrapping="Wrap"
                 automation:AutomationProperties.Name="Try-out text box" />
      </StackPanel>

    </StackPanel>
  </DockPanel>
</Window>
